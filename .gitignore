# Godot 4+ specific ignores
.godot/
/android/

# Godot .NET / mono 残留（本项目纯 GDScript，不提交 C# 工程文件）
.mono/
*.csproj
*.sln
.vs/

# 导出产物与配置（可能含签名路径/密钥）
export_presets.cfg
*.translation

# GUT 测试产物
.gut_junit.xml

# 美术生成中间产物与截图（源图存 assets/，这些是过程文件）
generated-images/
.shots/

# Godot 导入过程中的临时文件
# （`--import` 被中断/并发时会留下 `<文件>.import<pid>.tmp`，
#   它们不是资产也不是源码，但会被 `git add -A` 顺手带进来）
*.tmp

# 编辑器 / 系统
.DS_Store
Thumbs.db
desktop.ini

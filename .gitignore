# Godot 4+ specific ignores
.godot/
/android/

# Godot .NET / mono 残留（本项目纯 GDScript，不提交 C# 工程文件）
.mono/
*.csproj
*.sln
.vs/

# 导出产物与配置（可能含签名路径/密钥）
export_presets.cfg
*.translation

# GUT 测试产物
.gut_junit.xml

# 美术生成中间产物与截图（源图存 assets/，这些是过程文件）
generated-images/
.shots/
# 卡图缩小可读性验收的产物（verify_art.py preview）。
# ⚠️ 默认落在**仓库根目录**，不忽略的话 `git add -A` 会把几十张 QA 图带进来。
# 它同时会被 Godot 自动导入 → 记得目录里放空的 .gdignore。
preview_104/

# Godot 导入过程中的临时文件
# （`--import` 被中断/并发时会留下 `<文件>.import<pid>.tmp`，
#   它们不是资产也不是源码，但会被 `git add -A` 顺手带进来）
*.tmp

# 编辑器 / 系统
.DS_Store
Thumbs.db
desktop.ini

# ── AI 协作工作区（**不发布**）─────────────────────────────
# 里面是每日工作日志、项目内部约定，以及**含个人手机号/邮箱/住址的简历**。
# ⚠️ 这些**只留在本地**：公开仓库里绝不能出现。
# ⚠️ 注意：光加 .gitignore 只能挡住"以后"，**已提交的历史要用 filter-repo 清**。
.workbuddy-ai/

# 本机路径配置（含个人机器路径，不进版本库）
tools/.local_paths.sh

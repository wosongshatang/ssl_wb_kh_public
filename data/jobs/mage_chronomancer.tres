signature_card_ids = Array[StringName]([&"gold_chrono_rewind", &"gold_chrono_hasten"])
mirror_job_id = &"mirror_mage_chronomancer"
mirror_of = &""
power_scale = 1.0
mirror_starting_powers = {}

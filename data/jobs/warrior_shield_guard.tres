[gd_resource type="Resource" script_class="JobData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/identity/job_data.gd" id="1_jobdata"]

[resource]
script = ExtResource("1_jobdata")
id = &"warrior_shield_guard"
display_name = "盾卫"
description = "以身为墙。每回合获得的第一张格挡额外 +3。"
tier = 1
parent_job = &""
identity_power_ids = Array[StringName]([&"shield_guard_stance"])
job_card_ids = Array[StringName]([&"true_grit", &"iron_wave", &"shrug_it_off"])
card_pool_tags = Array[StringName]([&"warrior", &"defense"])
signature_card_ids = Array[StringName]([&"gold_guard_bulwark", &"gold_guard_brace"])
mirror_job_id = &"mirror_warrior_shield_guard"

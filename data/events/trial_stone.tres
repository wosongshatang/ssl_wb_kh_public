[gd_resource type="Resource" script_class="EventData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/map/event_data.gd" id="1_eventdata"]

[resource]
script = ExtResource("1_eventdata")
id = &"trial_stone"
title = "试炼石"
description = "一块被无数双手磨圆的黑色石头。传说把手按上去，它会称量你还能承受多少。"
